{
  "name": "@dustwright/viewer",
  "version": "0.0.0",
  "description": "Read-only Three.js viewer, shipped as a web component.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./bundle": "./dist/bundle/redstone-viewer.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build"
  },
  "dependencies": {
    "@dustwright/core": "workspace:*",
    "@dustwright/sim": "workspace:*",
    "@dustwright/validator": "workspace:*",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "vite": "7.3.7"
  }
}
