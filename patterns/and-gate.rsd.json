{
  "format": "rsd/1",
  "meta": {
    "name": "AND gate",
    "slug": "and-gate",
    "description": "Each input inverts through a torch; the torch outputs join (an OR of the inverses) and a last torch inverts again, so the lamp lights only when both inputs are on.",
    "gameVersion": "1.26.50"
  },
  "legend": {
    "#": "stone",
    "A": "lever mount=floor on=false",
    "B": "lever mount=floor on=false",
    "-": "dust",
    "t": "torch mount=west",
    "*": "lamp"
  },
  "layers": [
    ["#########", "#########", "#########"],
    ["A-#t-....", "....--#t*", "B-#t-...."]
  ],
  "ports": {
    "inputs": [
      {
        "name": "A",
        "pos": [0, 1, 0]
      },
      {
        "name": "B",
        "pos": [0, 1, 2]
      }
    ],
    "outputs": [
      {
        "name": "out",
        "pos": [8, 1, 1]
      }
    ]
  },
  "tests": [
    {
      "set": {
        "A": 0,
        "B": 0
      },
      "afterTicks": 8,
      "expect": {
        "out": 0
      }
    },
    {
      "set": {
        "A": 0,
        "B": 1
      },
      "afterTicks": 8,
      "expect": {
        "out": 0
      }
    },
    {
      "set": {
        "A": 1,
        "B": 0
      },
      "afterTicks": 8,
      "expect": {
        "out": 0
      }
    },
    {
      "set": {
        "A": 1,
        "B": 1
      },
      "afterTicks": 8,
      "expect": {
        "out": 1
      }
    }
  ],
  "annotations": [
    {
      "pos": [3, 1, 0],
      "text": "Input torch: off while A is on."
    },
    {
      "pos": [7, 1, 1],
      "text": "Output torch: lit only when both input torches are off."
    }
  ]
}
