  },
  "legend": {
    "#": "stone",
    "b": "button mount=floor material=stone",
    "-": "dust",
    ">": "repeater facing=east delay=4",
    "<": "repeater facing=west delay=4",
    "*": "lamp"
  },
  "layers": [
    ["######", "######", "####*#", "######"],
    ["......", ".->>-.", "b-..-.", ".-<<-."]
  ],
