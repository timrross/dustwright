{
  "format": "rsd/1",
  "meta": {
    "name": "XOR gate",
    "slug": "xor-gate",
    "description": "Three torch NOR stages: the middle torch is NOR(A, B); the top and bottom torches are NOR(A, middle) and NOR(B, middle), which are B and not A, and A and not B. Their outputs join on the lamp.",
    "gameVersion": "1.26.50"
  },
  "legend": {
    "#": "stone",
    "A": "lever mount=floor on=false",
    "B": "lever mount=floor on=false",
    "-": "dust",
    "t": "torch mount=west",
    "*": "lamp"
  },
  "layers": [
    ["######", "######", "######", "######", "######", "######"],
    ["......", "A--#t-", ".-.-.-", ".#t-.*", ".-.-.-", "B--#t-"]
  ],
  "ports": {
    "inputs": [
      {
        "name": "A",
        "pos": [0, 1, 1]
      },
      {
        "name": "B",
        "pos": [0, 1, 5]
      }
    ],
    "outputs": [
      {
        "name": "out",
        "pos": [5, 1, 3]
      }
    ]
  },
  "tests": [
    {
      "set": {
        "A": 0,
        "B": 0
      },
      "afterTicks": 10,
      "expect": {
        "out": 0
      }
    },
    {
      "set": {
        "A": 0,
        "B": 1
      },
      "afterTicks": 10,
      "expect": {
        "out": 1
      }
    },
    {
      "set": {
        "A": 1,
        "B": 0
      },
      "afterTicks": 10,
      "expect": {
        "out": 1
      }
    },
    {
      "set": {
        "A": 1,
        "B": 1
      },
      "afterTicks": 10,
      "expect": {
        "out": 0
      }
    }
  ],
  "annotations": [
    {
      "pos": [2, 1, 3],
      "text": "NOR(A, B): lit only when both inputs are off."
    },
    {
      "pos": [4, 1, 1],
      "text": "B and not A."
    },
    {
      "pos": [4, 1, 5],
      "text": "A and not B."
    }
  ]
}
