{"format":"rsd/1","meta":{"name":"Switched clock","edition":"bedrock","description":"A lever enables a torch clock. Lever off: the inverter torch keeps the clock torch's block powered, so the clock stops and the lamp stays dark. Lever on: the clock torch and a delay-4 repeater loop blink the lamp above the torch, about once a second."},"legend":{"#":"stone","L":"lever mount=east","C":"stone","t":"torch mount=west","v":"repeater facing=south delay=1","B":"stone","T":"torch mount=west","-":"dust","*":"lamp","^":"repeater facing=north delay=4"},"layers":[["#####","#####","#####","#####","#####"],["LCt..","..v..","..BT-","..^.-","..---"],[".....",".....","...*.",".....","....."]],"ports":{"inputs":[{"name":"run","pos":[0,1,0]}],"outputs":[{"name":"lamp","pos":[3,2,2]}]},"tests":[{"set":{"run":0},"afterTicks":40,"expect":{"lamp":0}},{"set":{"run":1},"afterTicks":6,"expect":{"lamp":1}},{"set":{"run":1},"afterTicks":11,"expect":{"lamp":0}},{"set":{"run":1},"afterTicks":16,"expect":{"lamp":1}}]}