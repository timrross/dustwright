{
  "format": "rsd/1",
  "meta": {
    "name": "Hidden 2x2 piston door",
    "edition": "bedrock",
    "gameVersion": "1.26.50",
    "description": "A flush 2x2 stone door in an east-west wall (doorway x=5..6, y=3..4, z=3). Four sticky pistons hidden in the wall hold the door blocks closed, powered by two torches. A wooden button on the north face and one on the south face of the west support block power it, turning the west torch off; dust under the floor (with a repeater) carries the signal to the east support. The door opens for the button press (about 1.5 s) and closes itself."
  },
  "legend": {
    "#": "stone",
    "-": "dust",
    ">": "repeater facing=east delay=1",
    "t": "torch mount=west",
    "u": "torch mount=east",
    "P": "sticky_piston facing=east",
    "Q": "sticky_piston facing=west",
    "n": "button mount=south material=wood",
    "s": "button mount=north material=wood"
  },
