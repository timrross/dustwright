{
  "format": "rsd/1",
  "meta": { "name": "NOR gate", "edition": "bedrock", "gameVersion": "1.26.50" },
  "legend": {
    "#": "stone",
    "A": "lever mount=east",
    "B": "lever mount=south",
    "t": "torch mount=west",
    "*": "lamp"
  },
  "layers": [
    ["#####", "#####"],
    ["..B..", ".A#t*"]
  ],
  "ports": {
    "inputs": [
      { "name": "A", "pos": [1, 1, 1] },
      { "name": "B", "pos": [2, 1, 0] }
    ],
    "outputs": [{ "name": "out", "pos": [4, 1, 1] }]
  },
  "tests": [
    { "set": { "A": 0, "B": 0 }, "afterTicks": 4, "expect": { "out": 1 } },
    { "set": { "A": 1, "B": 0 }, "afterTicks": 4, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 1 }, "afterTicks": 4, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 1 }, "afterTicks": 4, "expect": { "out": 0 } }
  ]
}
