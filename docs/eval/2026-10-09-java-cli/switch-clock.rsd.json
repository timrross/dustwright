{
  "format": "rsd/1",
  "meta": {
    "name": "Lever-switched torch clock",
    "edition": "java",
    "gameVersion": "26.3",
    "description": "Torch-repeater clock. While the lever is off, a NOT torch feeds a repeater that holds the clock block powered, so the clock torch stays off. Lever on releases it and the lamp blinks (about 5 ticks on, 5 off)."
  },
  "legend": {
    "#": "stone",
    "L": "lever mount=east",
    "n": "torch mount=west",
    "r": "repeater facing=east delay=1 powered=true",
    "t": "torch mount=west lit=false",
    "*": "lamp",
    "-": "dust",
    "^": "repeater facing=north delay=4"
  },
  "layers": [
    [".......", "#######", "#######", "#######"],
    [".......", "L#nr#t*", "....^-.", "....--."]
  ],
  "ports": {
    "inputs": [{ "name": "enable", "pos": [0, 1, 1] }],
    "outputs": [{ "name": "lamp", "pos": [6, 1, 1] }]
  },
  "tests": [
    { "set": { "enable": 0 }, "afterTicks": 20, "expect": { "lamp": 0 } },
    { "set": { "enable": 0 }, "afterTicks": 25, "expect": { "lamp": 0 } },
    { "set": { "enable": 1 }, "afterTicks": 6, "expect": { "lamp": 1 } },
    { "set": { "enable": 1 }, "afterTicks": 11, "expect": { "lamp": 0 } },
    { "set": { "enable": 1 }, "afterTicks": 16, "expect": { "lamp": 1 } },
    { "set": { "enable": 1 }, "afterTicks": 21, "expect": { "lamp": 0 } }
  ]
}
