{
  "format": "rsd/1",
  "meta": { "name": "NOR gate", "edition": "java", "gameVersion": "26.3" },
  "legend": {
    "#": "stone",
    "A": "lever mount=south",
    "B": "lever mount=north",
    "t": "torch mount=west",
    "*": "lamp"
  },
  "layers": [
    ["###", "###", "###"],
    ["A..", "#t*", "B.."]
  ],
  "ports": {
    "inputs": [{ "name": "A", "pos": [0, 1, 0] }, { "name": "B", "pos": [0, 1, 2] }],
    "outputs": [{ "name": "out", "pos": [2, 1, 1] }]
  },
  "tests": [
    { "set": { "A": 0, "B": 0 }, "afterTicks": 4, "expect": { "out": 1 } },
    { "set": { "A": 1, "B": 0 }, "afterTicks": 4, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 1 }, "afterTicks": 4, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 1 }, "afterTicks": 4, "expect": { "out": 0 } }
  ]
}
