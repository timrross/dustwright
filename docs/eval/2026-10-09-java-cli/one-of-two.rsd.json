{
  "format": "rsd/1",
  "meta": {
    "name": "XOR lamp",
    "edition": "java",
    "gameVersion": "26.3",
    "description": "The lamp lights only when exactly one of levers A and B is on. Two subtract-mode comparators each compute 'this lever AND NOT the other' (the other lever's signal, refreshed to 15 by a repeater, enters the side); their outputs OR into the lamp."
  },
  "legend": {
    "#": "stone",
    "L": "lever mount=floor",
    "-": "dust",
    "c": "comparator facing=east mode=subtract",
    "d": "comparator facing=west mode=subtract",
    "v": "repeater facing=south delay=1",
    "^": "repeater facing=north delay=1",
    "*": "lamp"
  },
  "layers": [
    ["#########", "#########", "#########", "#########", "#########"],
    ["..------.", "..v....-.", "L-c-*-d-L", ".-....^..", ".------.."]
  ],
  "ports": {
    "inputs": [
      { "name": "A", "pos": [0, 1, 2] },
      { "name": "B", "pos": [8, 1, 2] }
    ],
    "outputs": [{ "name": "out", "pos": [4, 1, 2] }]
  },
  "tests": [
    { "set": { "A": 0, "B": 0 }, "afterTicks": 8, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 0 }, "afterTicks": 8, "expect": { "out": 1 } },
    { "set": { "A": 0, "B": 1 }, "afterTicks": 8, "expect": { "out": 1 } },
    { "set": { "A": 1, "B": 1 }, "afterTicks": 8, "expect": { "out": 0 } }
  ]
}
