{
  "format": "rsd/1",
  "meta": {
    "name": "XNOR gate",
    "edition": "java",
    "gameVersion": "26.3",
    "description": "Lamp is lit when levers A and B are in the same position. NOR(A,B) torch and AND(A,B) torch both feed the lamp."
  },
  "legend": {
    "#": "stone",
    "L": "lever mount=floor",
    "-": "dust",
    "t": "torch mount=west",
    "T": "torch mount=east",
    "v": "repeater facing=south delay=1",
    "^": "repeater facing=north delay=1",
    "*": "lamp"
  },
  "layers": [
    [
      "############",
      "############",
      "############",
      "############",
      "############",
      "############",
      "############"
    ],
    [
      "L-------#t-.",
      "...-......-.",
      "...v......-.",
      "...#t---*T#.",
      "...^......-.",
      "...-......-.",
      "L-------#t-."
    ]
  ],
  "ports": {
    "inputs": [
      { "name": "A", "pos": [0, 1, 0] },
      { "name": "B", "pos": [0, 1, 6] }
    ],
    "outputs": [{ "name": "out", "pos": [8, 1, 3] }]
  },
  "tests": [
    { "set": { "A": 0, "B": 0 }, "afterTicks": 10, "expect": { "out": 1 } },
    { "set": { "A": 1, "B": 0 }, "afterTicks": 10, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 1 }, "afterTicks": 10, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 1 }, "afterTicks": 10, "expect": { "out": 1 } }
  ]
}
