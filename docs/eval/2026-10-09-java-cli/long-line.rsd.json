  "layers": [
    ["#########################################"],
    ["L--------------->--------------->-------*"]
  ],
  "ports": {
    "inputs": [{ "name": "A", "pos": [0, 1, 0] }],
    "outputs": [{ "name": "lamp", "pos": [40, 1, 0] }]
