{
  "format": "rsd/1",
  "meta": {
    "name": "3-input AND gate",
    "edition": "java",
    "gameVersion": "26.3",
    "description": "Each lever is inverted by a torch; the torches feed a shared dust line (NOR), which a final torch inverts to light the lamp only when all three levers are on."
  },
  "legend": {
    "#": "stone",
    "L": "lever mount=floor",
    "-": "dust",
    "t": "torch mount=west",
    "*": "lamp"
  },
  "layers": [
    [
      "#########",
      "#########",
      "#########",
      "#########",
      "#########"
    ],
    [
      "L-#t-....",
      "....-....",
      "L-#t--#t*",
      "....-....",
      "L-#t-...."
    ]
  ],
  "ports": {
    "inputs": [
      { "name": "A", "pos": [0, 1, 0] },
      { "name": "B", "pos": [0, 1, 2] },
      { "name": "C", "pos": [0, 1, 4] }
    ],
    "outputs": [{ "name": "out", "pos": [8, 1, 2] }]
  },
  "tests": [
    { "set": { "A": 0, "B": 0, "C": 0 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 0, "C": 0 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 1, "C": 0 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 0, "C": 1 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 1, "C": 0 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 0, "C": 1 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 0, "B": 1, "C": 1 }, "afterTicks": 6, "expect": { "out": 0 } },
    { "set": { "A": 1, "B": 1, "C": 1 }, "afterTicks": 6, "expect": { "out": 1 } }
  ]
}
